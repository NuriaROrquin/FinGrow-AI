# Copiar a .env y completar. El .env NO se commitea.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Secreto compartido con FinGrow-BE. Vacio en local => auth deshabilitada.
# En staging y produccion es obligatorio.
API_KEY=

# Proveedor de IA: stub | anthropic
LLM_PROVIDER=stub
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Transcripcion de audio: stub | openai
TRANSCRIPTION_PROVIDER=stub
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_TIMEOUT_SECONDS=60
TRANSCRIPTION_LANGUAGE=es
TRANSCRIPTION_MAX_AUDIO_BYTES=20971520

# Textract: stub | textract
OCR_PROVIDER=stub
OCR_AWS_REGION=us-east-1
OCR_AWS_ACCESS_KEY_ID=
OCR_AWS_SECRET_ACCESS_KEY=
OCR_TIMEOUT_SECONDS=30
OCR_MAX_DOCUMENT_BYTES=5242880
